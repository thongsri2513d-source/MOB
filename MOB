local states = {
    ESP = false,
    AimAssist = false,
    Speed = false,
    AutoCollect = false,
}

local function makeToggle(name, callback)
    local b = Instance.new("TextButton")
    b.Name = name
    b.AutoButtonColor = true
    b.BackgroundColor3 = Color3.fromRGB(36, 36, 45)
    b.BorderSizePixel = 0
    b.TextSize = 16
    b.Font = Enum.Font.GothamSemibold
    b.TextColor3 = Color3.new(1,1,1)
    b.Parent = content
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 12)

    local function refresh()
        b.Text = name .. " : " .. (states[name] and "ON" or "OFF")
    end

    refresh()

    b.Activated:Connect(function()
        states[name] = not states[name]
        refresh()
        callback(states[name])
    end)

    return b
end

makeToggle("ESP", function(enabled)
    -- Safe hook: connect this to your own game's ESP/debug system.
    print("ESP =", enabled)
end)

makeToggle("AimAssist", function(enabled)
    -- Safe hook: connect this to an assist system in your own game.
    print("AimAssist =", enabled)
end)

makeToggle("Speed", function(enabled)
    local character = player.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        humanoid.WalkSpeed = enabled and 24 or 16
    end
end)

makeToggle("AutoCollect", function(enabled)
    -- Safe hook: connect this to your own game's collectible system.
    print("AutoCollect =", enabled)
end)

